# NASA FIRMS API key — register at https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=your_firms_map_key_here

# Bounding box for India (min_lon, min_lat, max_lon, max_lat)
INDIA_BBOX=68,6,97,37

# PostgreSQL + PostGIS connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fire_detection

# Optional: MOSDAC credentials for INSAT-3D/3DS near-real-time layer
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
